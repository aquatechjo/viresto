{
  "name": "viresto",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run env:check",
    "build": "prisma generate && next build",
    "env:check": "node scripts/check-env.mjs",
    "test:unit": "node --import tsx --test tests/unit/report-finance.test.ts tests/unit/report-limits.test.ts tests/unit/money.test.ts tests/unit/subscription-consistency.test.ts tests/unit/plan-capacity.test.ts tests/unit/plan-entitlements.test.ts tests/unit/ai-usage-core.test.ts tests/unit/financial-audit.test.ts tests/unit/json-normalize.test.ts tests/unit/encryption-keyring.test.ts tests/unit/env-check.test.mjs tests/unit/csp.test.ts tests/unit/team-invitations.test.ts tests/unit/session-policy.test.ts tests/unit/health-check.test.ts",
    "smoke:production": "node scripts/production-smoke.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed:demo": "tsx prisma/seed-demo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@marsidev/react-turnstile": "^1.5.3",
    "@prisma/client": "^5.22.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "jose": "^5.10.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "luxon": "^3.7.2",
    "next": "16.2.10",
    "openai": "^6.48.0",
    "pdfmake": "^0.3.11",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "resend": "^6.17.2",
    "sonner": "^2.0.7",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^2.6.1",
    "unpdf": "^1.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/speakeasy": "^2.0.10",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.19",
    "prisma": "^5.22.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "postcss": "$postcss"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.16.0"
}
