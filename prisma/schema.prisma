generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  plan          Plan           @default(PRO)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isSuspended   Boolean        @default(false)
  maxUsers      Int            @default(5)
  status        TenantStatus   @default(ACTIVE)
  aiEnabled     Boolean        @default(false)
  aiConsentAt   DateTime?
  aiConsentBy   String?
  trialEndsAt   DateTime?
  address       String?
  email         String?
  logoUrl       String?
  phone         String?
  activities    Activity[]
  appointments  Appointment[]
  cases         Case[]
  clients       Client[]
  documents     Document[]
  invoices      Invoice[]
  notifications Notification[]
  payments      Payment[]
  sessions      Session[]
  tasks         Task[]
  users         User[]

  subscriptions        Subscription[]
  subscriptionPayments SubscriptionPayment[]
}

model BillingPlan {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  currency    String  @default("JOD")

  priceMonthly Int @default(0) // بالفلس: 15000 = 15 JOD
  priceYearly  Int @default(0) // بالفلس

  maxUsers     Int     @default(1)
  maxClients   Int     @default(25)
  maxCases     Int     @default(25)
  maxDocuments Int     @default(100)
  maxStorageMb Int     @default(500)
  aiEnabled    Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String
  planId   String

  provider               BillingProvider @default(MANUAL)
  providerCustomerId     String?
  providerSubscriptionId String?
  providerAgreementId    String?

  status   SubscriptionStatus @default(TRIALING)
  interval BillingInterval    @default(MONTHLY)

  currency String @default("JOD")
  amount   Int    @default(0) // بالفلس

  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     BillingPlan           @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([provider])
  @@index([currentPeriodEnd])
}

model SubscriptionPayment {
  id             String @id @default(cuid())
  tenantId       String
  subscriptionId String

  provider          BillingProvider @default(MANUAL)
  providerChargeId  String?
  providerInvoiceId String?

  amount   Int    @default(0) // بالفلس
  currency String @default("JOD")
  status   String @default("PENDING")

  paidAt DateTime?
  raw    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([provider])
  @@index([providerChargeId])
  @@index([status])
}

model PaymentWebhookEvent {
  id String @id @default(cuid())

  provider        BillingProvider
  providerEventId String?
  eventType       String?
  payload         Json

  processed Boolean @default(false)
  error     String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, providerEventId])
  @@index([provider])
  @@index([eventType])
  @@index([processed])
}

model User {
  id                String             @id @default(cuid())
  tenantId          String
  name              String
  email             String             @unique
  phone             String?
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  passwordHash      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isActive          Boolean            @default(true)
  role              UserRole           @default(LAWYER)
  twoFactorEnabled  Boolean            @default(false)
  twoFactorSecret   String?
  isSystemAdmin     Boolean            @default(false)
  sessions          Session[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  verificationCodes VerificationCode[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Client {
  id             String        @id @default(cuid())
  tenantId       String
  name           String
  email          String?
  phone          String?
  nationalId     String?
  address        String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  emailHash      String?
  nationalIdHash String?
  phoneHash      String?
  appointments   Appointment[]
  cases          Case[]
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents      Document[]
  invoices       Invoice[]
  tasks          Task[]
  archivedAt     DateTime?

  @@index([tenantId])
}

model Case {
  id           String        @id @default(cuid())
  tenantId     String
  clientId     String
  title        String
  caseNumber   String?
  court        String?
  description  String?
  status       CaseStatus    @default(OPEN)
  feeAgreed    Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents    Document[]
  invoices     Invoice[]
  payments     Payment[]
  tasks        Task[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  caseId    String
  amount    Float
  method    PaymentMethod @default(CASH)
  status    PaymentStatus @default(PAID)
  paidAt    DateTime      @default(now())
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  invoiceId String?       @unique
  case      Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id])
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  clientId    String?
  caseId      String?
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  location    String?
  type        AppointmentType   @default(MEETING)
  status      AppointmentStatus @default(SCHEDULED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  case        Case?             @relation(fields: [caseId], references: [id])
  client      Client?           @relation(fields: [clientId], references: [id])
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, startTime])
}

model Document {
  id           String    @id @default(cuid())
  tenantId     String
  clientId     String?
  caseId       String?
  fileName     String
  fileType     String
  fileUrl      String
  fileSize     Int?
  publicId     String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  aiAmounts    Json?
  aiAnalyzedAt DateTime?
  aiDates      Json?
  aiKeyPoints  Json?
  aiParties    Json?
  aiSummary    String?
  tags         String[]  @default([])
  case         Case?     @relation(fields: [caseId], references: [id])
  client       Client?   @relation(fields: [clientId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Task {
  id          String       @id @default(cuid())
  tenantId    String
  clientId    String?
  caseId      String?
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  completed   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  case        Case?        @relation(fields: [caseId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id])
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, completed])
}

model Activity {
  id         String   @id @default(cuid())
  tenantId   String
  type       String
  title      String
  message    String?
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())
  actorId    String?
  ipAddress  String?
  userAgent  String?
  city       String?
  country    String?
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
}

model Notification {
  id         String   @id @default(cuid())
  tenantId   String
  title      String
  message    String?
  type       String   @default("INFO")
  entityType String?
  entityId   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, read])
  @@index([createdAt])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  tenantId       String
  tokenHash      String   @unique
  ipAddress      String?
  userAgent      String?
  isActive       Boolean  @default(true)
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  city           String?
  country        String?
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([isActive])
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  clientId      String
  caseId        String?
  invoiceNumber String
  status        InvoiceStatus @default(UNPAID)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Float         @default(0)
  tax           Float         @default(0)
  discount      Float         @default(0)
  total         Float         @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  case          Case?         @relation(fields: [caseId], references: [id])
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]
  payment       Payment?

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([caseId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum BillingProvider {
  MANUAL
  TAP
  PAYTABS
  HYPERPAY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  UNPAID
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum TenantStatus {
  ACTIVE
  TRIAL
  EXPIRED
  SUSPENDED
}

enum UserRole {
  ADMIN
  LAWYER
  STAFF
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  ONLINE
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
}

enum AppointmentType {
  MEETING
  COURT_SESSION
  PHONE_CALL
  DEADLINE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum VerificationType {
  EMAIL
  WHATSAPP
}

model VerificationCode {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     VerificationType
  codeHash String

  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId, type])
}
