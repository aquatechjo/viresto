generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  plan          Plan           @default(PRO)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isSuspended   Boolean        @default(false)
  maxUsers      Int            @default(5)
  status        TenantStatus   @default(ACTIVE)
  aiEnabled     Boolean        @default(false)
  aiConsentAt   DateTime?
  aiConsentBy   String?
  trialEndsAt   DateTime?
  address       String?
  email         String?
  logoUrl       String?
  phone         String?
  activities    Activity[]
  appointments  Appointment[]
  cases         Case[]
  caseMembers   CaseMember[]
  clients       Client[]
  documents     Document[]
  invoices      Invoice[]
  notifications Notification[]
  payments      Payment[]
  sessions      Session[]
  tasks         Task[]
  users         User[]

  subscriptions        Subscription[]
  subscriptionPayments SubscriptionPayment[]
}

model BillingPlan {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  currency    String  @default("JOD")

  priceMonthly Int @default(0) // بالفلس: 15000 = 15 JOD
  priceYearly  Int @default(0) // بالفلس

  maxUsers     Int     @default(1)
  maxClients   Int     @default(25)
  maxCases     Int     @default(25)
  maxDocuments Int     @default(100)
  maxStorageMb Int     @default(500)
  aiEnabled    Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String
  planId   String

  provider               BillingProvider @default(MANUAL)
  providerCustomerId     String?
  providerSubscriptionId String?
  providerAgreementId    String?

  status   SubscriptionStatus @default(TRIALING)
  interval BillingInterval    @default(MONTHLY)

  currency String @default("JOD")
  amount   Int    @default(0) // بالفلس

  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     BillingPlan           @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([provider])
  @@index([currentPeriodEnd])
}

model SubscriptionPayment {
  id             String @id @default(cuid())
  tenantId       String
  subscriptionId String

  provider          BillingProvider @default(MANUAL)
  providerChargeId  String?
  providerInvoiceId String?

  amount   Int    @default(0) // بالفلس
  currency String @default("JOD")
  status   String @default("PENDING")

  method          String?
  receiptUrl      String?
  receiptPublicId String?

  adminNote    String?
  reviewedById String?
  reviewedAt   DateTime?

  paidAt DateTime?
  raw    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([provider])
  @@index([providerChargeId])
  @@index([status])
  @@index([reviewedAt])
}

model PaymentWebhookEvent {
  id String @id @default(cuid())

  provider        BillingProvider
  providerEventId String?
  eventType       String?
  payload         Json

  processed Boolean @default(false)
  error     String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, providerEventId])
  @@index([provider])
  @@index([eventType])
  @@index([processed])
}

model User {
  id                 String              @id @default(cuid())
  tenantId           String
  name               String
  email              String              @unique
  phone              String?
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  passwordHash       String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isActive           Boolean             @default(true)
  role               UserRole            @default(LAWYER)
  twoFactorEnabled   Boolean             @default(false)
  twoFactorSecret    String?
  isSystemAdmin      Boolean             @default(false)
  sessions           Session[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  verificationCodes  VerificationCode[]
  passwordResetCodes PasswordResetCode[]
  assignedTasks       Task[]              @relation("TaskAssignee")
  createdTasks        Task[]              @relation("TaskCreator")
  leadCases           Case[]              @relation("CaseLeadLawyer")
  caseMemberships     CaseMember[]
  assignedAppointments Appointment[]      @relation("AppointmentAssignee")
  createdAppointments  Appointment[]      @relation("AppointmentCreator")

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Client {
  id             String        @id @default(cuid())
  tenantId       String
  name           String
  email          String?
  phone          String?
  nationalId     String?
  address        String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  emailHash      String?
  nationalIdHash String?
  phoneHash      String?
  appointments   Appointment[]
  cases          Case[]
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents      Document[]
  invoices       Invoice[]
  payments       Payment[]
  tasks          Task[]
  archivedAt     DateTime?

  @@index([tenantId])
}

model Case {
  id            String     @id @default(cuid())
  tenantId      String
  clientId      String
  leadLawyerId  String?
  title         String
  caseNumber    String?
  court         String?
  judgeName     String?
  plaintiffName String?
  defendantName String?
  description   String?
  status        CaseStatus @default(OPEN)
  feeAgreed     Float      @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  appointments Appointment[]
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadLawyer   User?         @relation("CaseLeadLawyer", fields: [leadLawyerId], references: [id], onDelete: SetNull)
  members      CaseMember[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents    Document[]
  invoices     Invoice[]
  payments     Payment[]
  tasks        Task[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, caseNumber])
  @@index([tenantId, leadLawyerId])
}

model CaseMember {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String
  userId    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([caseId])
}

model Payment {
  id       String @id @default(cuid())
  tenantId String

  // الدفعة تتبع الموكل ماليًا، حتى لو لم تكن مرتبطة بقضية.
  clientId String

  // القضية اختيارية لدعم فواتير الاستشارات والخدمات غير المرتبطة بقضية.
  caseId String?

  // الفاتورة اختيارية، ويمكن للفاتورة أن تستقبل عدة دفعات.
  invoiceId String?

  amount Float

  method PaymentMethod @default(CASH)
  status PaymentStatus @default(PAID)

  // يبقى فارغًا للدفعات المعلقة، ويُحدد فقط عند التحصيل الفعلي.
  paidAt DateTime?

  // رقم الحوالة أو الشيك أو مرجع بوابة الدفع.
  reference String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  case    Case?    @relation(fields: [caseId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([clientId])
  @@index([caseId])
  @@index([invoiceId])
}

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  clientId    String?
  caseId      String?
  assignedToId String?
  createdById  String?
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  location    String?
  type        AppointmentType   @default(MEETING)
  status      AppointmentStatus @default(SCHEDULED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  case        Case?             @relation(fields: [caseId], references: [id])
  client      Client?           @relation(fields: [clientId], references: [id])
  assignedTo  User?             @relation("AppointmentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, startTime])
  @@index([tenantId, assignedToId, startTime])
  @@index([createdById])
}

model Document {
  id           String    @id @default(cuid())
  tenantId     String
  clientId     String?
  caseId       String?
  fileName     String
  fileType     String
  fileUrl      String
  fileSize     Int?
  publicId     String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  aiAmounts    Json?
  aiAnalyzedAt DateTime?
  aiDates      Json?
  aiKeyPoints  Json?
  aiParties    Json?
  aiSummary    String?
  tags         String[]  @default([])
  case         Case?     @relation(fields: [caseId], references: [id])
  client       Client?   @relation(fields: [clientId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Task {
  id           String       @id @default(cuid())
  tenantId     String
  clientId     String?
  caseId       String?
  assignedToId String?
  createdById  String?
  title        String
  description  String?
  dueDate      DateTime?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  completed    Boolean      @default(false)
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  case         Case?        @relation(fields: [caseId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, completed])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId, status])
  @@index([tenantId, dueDate])
  @@index([createdById])
}

model Activity {
  id         String   @id @default(cuid())
  tenantId   String
  type       String
  title      String
  message    String?
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())
  actorId    String?
  ipAddress  String?
  userAgent  String?
  city       String?
  country    String?
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt, id])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, entityType, createdAt])
  @@index([tenantId, actorId, createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  BILLING
  APPOINTMENT
  CASE
  DOCUMENT
  INVOICE
  PAYMENT
  TASK
  SYSTEM
}

model Notification {
  id       String           @id @default(cuid())
  tenantId String
  userId   String?
  type     NotificationType @default(INFO)

  titleAr   String
  titleEn   String
  messageAr String
  messageEn String

  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, readAt])
  @@index([userId])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  tenantId       String
  tokenHash      String   @unique
  ipAddress      String?
  userAgent      String?
  isActive       Boolean  @default(true)
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  city           String?
  country        String?
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([isActive])
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  clientId      String
  caseId        String?
  invoiceNumber String
  status        InvoiceStatus @default(UNPAID)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Float         @default(0)
  tax           Float         @default(0)
  discount      Float         @default(0)
  total         Float         @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  case          Case?         @relation(fields: [caseId], references: [id])
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([caseId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum BillingProvider {
  MANUAL
  TAP
  PAYTABS
  HYPERPAY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  UNPAID
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum TenantStatus {
  ACTIVE
  TRIAL
  EXPIRED
  SUSPENDED
}

enum UserRole {
  ADMIN
  LAWYER
  STAFF
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  ONLINE
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
}

enum AppointmentType {
  MEETING
  COURT_SESSION
  PHONE_CALL
  DEADLINE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  URGENT
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum VerificationType {
  EMAIL
  WHATSAPP
}

model VerificationCode {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     VerificationType
  codeHash String

  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId, type])
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
