# Every environment variable the app, scripts and tests read. Copy to .env
# for local development and fill in DEVELOPMENT values only (OPERATIONS.md,
# "Development environment"). Next.js and the Prisma CLI both read .env;
# keep database URLs there, never in .env.local (Prisma does not read it).
# Production values live only in Vercel.

# --- Database ---------------------------------------------------------------
# Pooled URL used by the app (locally: the Neon dev branch, never production).
DATABASE_URL=""
# Direct (non-pooler) URL used by Prisma migrations.
DIRECT_URL=""
# Endpoint id (ep-...) of the PRODUCTION Neon branch. Local only: the dev
# server and the local Prisma scripts refuse to run against it, and refuse
# any Neon URL while it is unset (scripts/check-dev-keys.mjs).
PROD_DB_ENDPOINT_ID=""

# --- Signed tokens and secrets (a different random value for each) ----------
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Session tokens; at least 32 characters.
JWT_SECRET=""
# Password reset codes.
PASSWORD_RESET_SECRET=""
# Email verification codes.
VERIFICATION_SECRET=""
# Bearer secret for /api/cron/*.
CRON_SECRET=""
# Bearer secret for authenticated /api/health checks (distinct from CRON_SECRET).
HEALTHCHECK_SECRET=""

# --- PII encryption -----------------------------------------------------------
# 32 random bytes, base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Id stored with every ciphertext (e.g. "primary"; "dev" locally).
ENCRYPTION_KEY_ID=""
# During a key rotation: old keys as comma-separated keyId=base64 entries.
ENCRYPTION_PREVIOUS_KEYS=""
# HMAC secret of the client search hashes. Keep it stable: changing it needs
# a hash backfill.
SEARCH_HASH_SECRET=""

# --- Application ---------------------------------------------------------------
# Base URL for email links and Polar return URLs (locally http://localhost:3000).
APP_URL=""
# Same, exposed to the browser.
NEXT_PUBLIC_APP_URL=""
# Comma-separated hosts allowed to call server actions (locally localhost:3000).
ALLOWED_SERVER_ACTION_ORIGINS=""
# Product name in emails (default "Viresto").
APP_NAME=""

# --- Registration ----------------------------------------------------------------
# Public signup on the server; must match NEXT_PUBLIC_REGISTER_ENABLED.
PUBLIC_REGISTER_ENABLED=""
# Public signup in the UI.
NEXT_PUBLIC_REGISTER_ENABLED=""
# "true" checks Cloudflare Turnstile on signup.
TURNSTILE_ENABLED=""
# Turnstile secret. Locally Cloudflare's test secret 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=""
# Turnstile site key. Locally Cloudflare's test key 1x00000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Cloudinary (documents and logos) ----------------------------------------------
# Locally a separate dev cloud, or empty (uploads then fail).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Upstash Redis (rate limiting) ----------------------------------------------
# Empty locally = in-memory limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Email (Resend) -----------------------------------------------------------------
# Empty locally: codes print to the dev server log. The dev server refuses a
# key that sends from the production domain.
RESEND_API_KEY=""
# Sender, e.g. "Viresto <verify@example.com>".
EMAIL_FROM=""
# Reply-to address (defaults to the support address).
EMAIL_REPLY_TO=""

# --- AI (OpenAI) ----------------------------------------------------------------------
# Empty = AI features off.
OPENAI_API_KEY=""
# Model of the assistant chat (default gpt-4o-mini).
OPENAI_CHAT_MODEL=""
# Model of document summaries and image OCR (default gpt-4o-mini).
OPENAI_DOCUMENT_MODEL=""

# --- Polar (subscriptions) ------------------------------------------------------------
# Locally a SANDBOX token only, or empty.
POLAR_ACCESS_TOKEN=""
# Signing secret of the Polar webhook endpoint.
POLAR_WEBHOOK_SECRET=""
# "sandbox" or "production" (unset = sandbox). "production" on Vercel
# Production (checked at build); the dev server accepts a token only with
# "sandbox".
POLAR_ENVIRONMENT=""

# --- Sentry (optional; off when the DSN is empty) ---------------------------------------
# Public DSN (it only accepts events).
NEXT_PUBLIC_SENTRY_DSN=""
# Share of requests traced, 0 to 1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=""
# Build-time source map upload; the build does not fail without them.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Guards and checks ------------------------------------------------------------------
# "1" starts the dev server despite production billing/email keys or URLs
# (still warns). Never bypasses the production-database check.
ALLOW_PRODUCTION_KEYS_IN_DEV=""
# "true" makes scripts/check-env.mjs fail (not just warn) outside production.
ENV_VALIDATION_STRICT=""
# Base URL scripts/production-smoke.mjs checks (default https://www.virestojo.com).
PRODUCTION_URL=""
# Transaction timeout override for Prisma, in ms (optional).
PRISMA_TRANSACTION_TIMEOUT_MS=""
# Auth cache TTL override, in ms (optional; tests use it).
AUTH_CACHE_TTL_MS=""

# --- Tests (put these in .env.local) ------------------------------------------------------
# Integration tests: a DIRECT URL on the dev branch or localhost; each run
# migrates and drops its own "it_*" schema there. Never production.
INTEGRATION_DATABASE_URL=""
# The only non-localhost database host the E2E seed and integration tests accept.
E2E_ALLOWED_DATABASE_HOST=""
# E2E login user (seeded by npm run seed:e2e) and target URL.
E2E_TEST_EMAIL=""
E2E_TEST_PASSWORD=""
E2E_BASE_URL=""
# "1" lets E2E runs skip rate limits (local only).
E2E_RATE_LIMIT_BYPASS=""
# "1" saves screenshots in the demo-mode E2E spec.
E2E_DEMO_SCREENSHOTS=""
