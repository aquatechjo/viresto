# Database
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Authentication and signed tokens — use a different random value for each
JWT_SECRET="change-me-generate-a-unique-secret"
PASSWORD_RESET_SECRET="change-me-generate-another-unique-secret"
VERIFICATION_SECRET="change-me-generate-another-unique-secret"

# PII encryption
# Generate ENCRYPTION_KEY with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="base64-encoded-32-byte-key"
ENCRYPTION_KEY_ID="primary"
# During rotation keep old keys as comma-separated keyId=base64 entries.
ENCRYPTION_PREVIOUS_KEYS=""

# Search hashes — keep this value stable; rotating it requires a hash backfill.
SEARCH_HASH_SECRET="change-me-generate-a-unique-stable-secret"

# Application
NODE_ENV="development"
APP_URL="https://www.virestojo.com"
NEXT_PUBLIC_APP_URL="https://www.virestojo.com"
ALLOWED_SERVER_ACTION_ORIGINS="virestojo.com,www.virestojo.com"
APP_NAME="Viresto"

# Registration — both flags must match
PUBLIC_REGISTER_ENABLED="false"
NEXT_PUBLIC_REGISTER_ENABLED="false"
TURNSTILE_ENABLED="false"
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Cloudinary private files
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Distributed rate limiting
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Email
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Viresto <info@aquatechagency.com>"
EMAIL_REPLY_TO="support@aquatechagency.com"

# Scheduled jobs
CRON_SECRET="change-me-generate-a-unique-secret"

# Authenticated production readiness checks — use a secret distinct from CRON_SECRET
HEALTHCHECK_SECRET=""

# AI (optional; required when AI features are enabled for tenants)
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_DOCUMENT_MODEL="gpt-4o-mini"

# Polar.sh billing
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
# "production" or "sandbox" — defaults to "sandbox" when unset (fail-safe).
# Must be "production" on the Vercel Production deployment (checked at build).
POLAR_ENVIRONMENT="sandbox"

# Sentry error monitoring (optional; off when the DSN is empty).
# The DSN is public by design (it only accepts events). Set it for
# Production (and Preview if wanted) on Vercel.
NEXT_PUBLIC_SENTRY_DSN=""
# Share of requests traced for performance (0 to 1). 0 keeps the free tier
# for errors only.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"
# Build-time only, for readable stack traces (source map upload). Leave
# empty to skip the upload; the build does not fail without them.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Integration tests (npm run test:integration) — a DIRECT (non-pooler) Postgres
# URL. Only localhost or E2E_ALLOWED_DATABASE_HOST (the Neon dev branch) is
# accepted; each run migrates and then drops its own "it_*" schema there.
# Never point this at production.
INTEGRATION_DATABASE_URL=""

# Env validation strictness — "true" makes scripts/check-env.mjs fail (not just
# warn) outside NODE_ENV=production/VERCEL_ENV=production. Leave unset locally.
ENV_VALIDATION_STRICT=""

# Base URL scripts/production-smoke.mjs targets after deploy — must be https
# (or localhost). Defaults to https://www.virestojo.com when unset.
PRODUCTION_URL="https://www.virestojo.com"
